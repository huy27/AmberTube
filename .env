# YouTube Data API v3 key (enables live search). Without it the app runs on the demo catalogue.
VITE_YOUTUBE_API_KEY=AIzaSyBqjHrV_CiCy-H9RsINPvZLa13vT_hWl_Y

# Your conversion backend (see README > Downloads). Leave empty to simulate conversions for demo tracks.
VITE_CONVERSION_ENDPOINT=

# Comma-separated YouTube channel IDs you own or hold rights to. Only these are eligible for MP3 conversion.
VITE_AUTHORIZED_CHANNEL_IDS=

# Licensed lyrics service (e.g. your Musixmatch / LyricFind backend). GET ?title=&artist=&duration= -> { lrc | plain | instrumental, source }
VITE_LYRICS_ENDPOINT=
