{
  "name": "ambertube",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --no-warnings --test src/playback/*.test.ts src/focus/*.test.ts src/search/*.test.ts src/recommend/*.test.ts src/artists/*.test.ts src/charts/*.test.ts src/sync/*.test.ts src/voice/*.test.ts",
    "test:db": "node --test supabase/test/rls.test.mjs supabase/test/limits.test.mjs supabase/test/api-usage.test.mjs",
    "preview": "vite preview",
    "test:e2e": "node e2e/run.cjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "5.6",
    "vite": "^5.4.11"
  }
}
